#!/bin/bash
# Merman OS launcher. Double-click: sets itself up the first time, updates itself, opens its own window.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
APP="$HOME/.mermanos"; mkdir -p "$APP"; exec >>"$APP/app.log" 2>&1
URL="http://127.0.0.1:8765/"
say() { osascript -e "display notification \"$1\" with title \"Merman OS\"" >/dev/null 2>&1; }
box() { osascript -e "display dialog \"$1\" buttons {\"OK\"} default button 1 with title \"Merman OS\"" >/dev/null 2>&1; }

# python 3.10+
PY=""
for p in python3.13 python3.12 python3.11 python3.10 python3; do
  c=$(command -v "$p") || continue
  "$c" -c 'import sys; sys.exit(sys.version_info < (3,10))' 2>/dev/null && { PY="$c"; break; }
done
if [ -z "$PY" ]; then
  box "Merman OS needs Python 3.10 or newer. The python.org page will open. Install it, then open Merman OS again."
  open "https://www.python.org/downloads/macos/"; exit 1
fi

# latest code from GitHub (works without git; skipped if offline)
SRC="$APP/src"
if curl -fsL -m 60 "https://github.com/paramminhas5/mermanos/archive/refs/heads/main.tar.gz" -o "$APP/src.tgz"; then
  rm -rf "$APP/new" && mkdir -p "$APP/new" && tar -xzf "$APP/src.tgz" -C "$APP/new" --strip-components=1 && rm -rf "$SRC" && mv "$APP/new" "$SRC"
fi
[ -d "$SRC" ] || { box "Could not download Merman OS. Check your internet and open it again."; exit 1; }

# stop any older copy that is still running, so you always get the newest version
pkill -f "crate.cli serve" 2>/dev/null; pkill -f "bin/crate serve" 2>/dev/null
lsof -ti tcp:8765 2>/dev/null | xargs kill 2>/dev/null
sleep 1

FIRST=0
if [ ! -x "$APP/venv/bin/crate" ]; then
  FIRST=1; say "First run: setting up. This takes a couple of minutes."
  "$PY" -m venv "$APP/venv" || { box "Could not create the Python environment. See ~/.mermanos/app.log"; exit 1; }
fi
"$APP/venv/bin/pip" install -q -e "$SRC[app]" || "$APP/venv/bin/pip" install -q -e "$SRC" || { box "Install failed. See ~/.mermanos/app.log"; exit 1; }
export PATH="$APP/venv/bin:$PATH"

HOME_DIR="${CRATE_HOME:-$HOME/.crate}"
if [ ! -f "$HOME_DIR/config.toml" ]; then
  crate init
  EMAIL=$(osascript -e 'text returned of (display dialog "Your email. It is sent only to MusicBrainz so they can contact you if the lookups misbehave." default answer "" with title "Merman OS")' 2>/dev/null)
  LIB="$HOME/Music-Library"; [ -d "$LIB" ] || LIB="$HOME/Music"
  sed -i.bak "s|^library_root *=.*|library_root = \"$LIB\"|; s|^contact *=.*|contact = \"$EMAIL\"|; s|^seed_artists *=.*|seed_artists = 70|; s|^max_candidates *=.*|max_candidates = 100|" "$HOME_DIR/config.toml"
  # your taste file stays on your Mac: ~/Music/merman-seeds.txt (or edit ~/.crate/seeds.txt)
  if [ -s "$HOME/Music/merman-seeds.txt" ]; then cp "$HOME/Music/merman-seeds.txt" "$HOME_DIR/seeds.txt"; else cp "$SRC/seeds.example.txt" "$HOME_DIR/seeds.txt"; fi
fi

# online copy (paramminhas.com/mermanos): needs git and push access to your ParamOS repo
if [ ! -d "$HOME/ParamOS/.git" ]; then GIT_TERMINAL_PROMPT=0 git clone -q https://github.com/paramminhas5/ParamOS "$HOME/ParamOS" 2>/dev/null || echo "ParamOS clone skipped"; fi
if [ -d "$HOME/ParamOS/.git" ] && ! grep -q '^publish_dir' "$HOME_DIR/config.toml"; then
  echo 'publish_dir = "~/ParamOS"' | cat - "$HOME_DIR/config.toml" > "$HOME_DIR/config.tmp" && mv "$HOME_DIR/config.tmp" "$HOME_DIR/config.toml"
fi

if [ "$FIRST" = 1 ]; then
  crate scan || true
  crate schedule --at 08:00 --install && launchctl load -w "$HOME/Library/LaunchAgents/com.merman.crate.plist" 2>/dev/null
  nohup sh -c "crate daily --discover >>'$HOME_DIR/daily.log' 2>&1" >/dev/null 2>&1 &
else
  nohup sh -c "crate daily --skip-discover --no-publish >>'$HOME_DIR/daily.log' 2>&1" >/dev/null 2>&1 &
fi
# its own window; closing the window quits Merman OS. Falls back to the browser if the window part is missing.
exec crate serve --window
